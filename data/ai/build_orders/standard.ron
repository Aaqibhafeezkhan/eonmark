// Standard: the single v0.1 opponent (M5b). Schema: crates/rules/src/ai.rs
// (deny_unknown_fields). A step is done when the view shows it (buildings and
// sites owned, units alive or queued, techs researched or queued, the age
// reached), never when its command is issued. Knobs: personalities.ron.
(
  id: "standard",
  steps: [
    Workers(count: 7, split: {"grain": 3, "lumber": 4}),
    Build(kind: "croft", count: 2, at: NearTown),
    Build(kind: "lumber_yard", count: 1, at: Terrain),
    Build(kind: "scriptorium", count: 1, at: NearTown),
    Workers(count: 9, split: {"grain": 4, "lumber": 5}),
    Train(kind: "scribe", count: 3),
    Build(kind: "croft", count: 3, at: NearTown),
    Build(kind: "lumber_yard", count: 2, at: Terrain),  // one yard has ~4 slots
    Build(kind: "ore_pit", count: 1, at: Terrain),
    Workers(count: 11, split: {"grain": 4, "lumber": 5, "ore": 2}),
    Build(kind: "town", count: 2, at: Expansion, optional: true),
    Build(kind: "muster_hall", count: 1, at: NearTown),
    Military,                                   // production starts; latched
    Research(tech: "arms_1"),                   // age tech 1; pop 25 -> 50
    // M6: a second Muster Hall now and a third after Masonry, so income
    // (the level's bonus included) becomes army instead of a stockpile.
    Build(kind: "muster_hall", count: 2, at: NearTown),
    Build(kind: "croft", count: 5, at: NearTown),
    Workers(count: 14, split: {"grain": 5, "lumber": 6, "ore": 3}),
    Research(tech: "trade_1"),                  // age tech 2; Yield Cap up
    Build(kind: "watchtower", count: 1, at: BorderEdge, optional: true),
    Advance(age: "masonry"),
    Build(kind: "muster_hall", count: 3, at: NearTown),
    Build(kind: "engine_yard", count: 1, at: NearTown),
    Train(kind: "mangonel", count: 1),          // the first wave's siege, saved up for
    Build(kind: "scriptorium", count: 2, at: NearTown), // Lore for the Charter techs
    Train(kind: "scribe", count: 6),
    Research(tech: "harrying_1", optional: true),     // hosted by the Watchtower
    Research(tech: "arms_2"),
    Build(kind: "croft", count: 8, at: NearTown, optional: true),  // needs the 2nd Town
    Workers(count: 17, split: {"grain": 8, "lumber": 6, "ore": 3}),
    Research(tech: "letters_1"),                // research 10% cheaper and faster
    Research(tech: "trade_2"),
    Research(tech: "statecraft_1"),
    Advance(age: "charter"),                    // 6 counting techs before it
    Research(tech: "arms_3"),
    // After the Charter: more Lumber and Ore, so the waves grow (pop 100
    // with Arms III).
    Build(kind: "lumber_yard", count: 3, at: Terrain),
    Workers(count: 20, split: {"grain": 8, "lumber": 8, "ore": 4}),
    Build(kind: "ore_pit", count: 2, at: Terrain),
    Workers(count: 23, split: {"grain": 8, "lumber": 10, "ore": 5}),
  ],
)
