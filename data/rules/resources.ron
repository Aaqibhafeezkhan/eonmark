// Eonmark resources. Schema: crates/rules/src/resources.rs (deny_unknown_fields).
// gathered_from lists building ids and must equal the buildings.ron kinds
// whose base_yield or gather names the resource. Yield-capped resources flatline
// at the Yield Cap (yield_cap_base in rules.ron, changed by YieldCap rows in
// techs.ron and factions.ron); a resource with yield_capped: false must set
// stockpile_cap.
(
  resources: [
    (
      id: "grain",
      name: "Grain",
      gathered_from: ["town", "croft"],
      role: "Primary unit cost and age advance cost.",
      yield_capped: true,
      stockpile_cap: None,
    ),
    (
      id: "lumber",
      name: "Lumber",
      gathered_from: ["town", "lumber_yard"],
      role: "Building cost; Bowman, Mangonel and Supply Wain cost.",
      yield_capped: true,
      stockpile_cap: None,
    ),
    (
      id: "ore",
      name: "Ore",
      gathered_from: ["ore_pit"],
      role: "Shieldbearer, Outrider, Watchtower and Arms-line techs; the scarce military resource.",
      yield_capped: true,
      stockpile_cap: None,
    ),
    (
      id: "lore",
      name: "Lore",
      gathered_from: ["scriptorium"],
      role: "Research and age advance currency; exempt from the Yield Cap; not tradeable.",
      yield_capped: false,
      stockpile_cap: Some(999),
    ),
  ],
)
