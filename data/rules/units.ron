      name: "Supply Wain",
      speed_tiles_per_s_x100: 160,
      radius_tiles_x100: 50,
      arrive_radius_tiles_x100: 25,
      arrive_slowdown_radius_tiles_x100: 50,
      waypoint_radius_tiles_x100: 50,
      separation_tiles_x100: 10,
      return_to_post_radius_tiles_x100: 100,
      class: Support,
      hp: 150,
      cost: {"lumber": 100},
      ramp: Military,
      pop: 2,
      train_time_ds: 300,
      trainer: "engine_yard",
      vision_tiles: 8,
    ),
  ],
  // Counter table (permille). Skirmishers beat Bowmen, Bowmen beat
  // Shieldbearers, Shieldbearers beat Outriders, Outriders beat Bowmen,
  // Skirmishers and Mangonels, and Mangonels beat buildings; the other
  // armed kinds do a quarter of their damage to buildings.
  counters: [
    (attacker: "skirmisher", defender: Kind("bowman"), permille: 2500),
    (attacker: "bowman", defender: Kind("shieldbearer"), permille: 3000),
    (attacker: "shieldbearer", defender: Kind("outrider"), permille: 3000),
    (attacker: "outrider", defender: Kind("bowman"), permille: 2500),
    (attacker: "outrider", defender: Kind("skirmisher"), permille: 1500),
    (attacker: "outrider", defender: Kind("mangonel"), permille: 3000),
    (attacker: "mangonel", defender: Buildings, permille: 4000),
    (attacker: "skirmisher", defender: Buildings, permille: 250),
    (attacker: "shieldbearer", defender: Buildings, permille: 250),
    (attacker: "bowman", defender: Buildings, permille: 250),
    (attacker: "outrider", defender: Buildings, permille: 250),
  ],
)
