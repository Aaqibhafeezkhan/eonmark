// Eonmark unit kinds. Schema: crates/rules/src/units.rs (deny_unknown_fields).
// List index is the UnitKindId; yeoman stays at 0. Integers only: fields
// ending in _x100 are scaled by 100 (180 = 1.80 tiles per second). The sim
// converts speed to tiles per tick and radii to fixed-point exactly once,
// at spawn. radius_tiles_x100 is at most 50.
// return_to_post_radius_tiles_x100: an arrived unit pushed farther than this
// from the tile centre it arrived at walks straight back (100 = one tile).
// Training (M3a): class, cost per resource id, ramp (Flat when absent,
// PerUnit({...}) per unit alive or queued, Military for the shared trainer
// queue ramp in rules.ron), pop, train_time_ds, trainer (a buildings.ron
// id), builder, vision_tiles.
// Combat (M4a): hp; attack: Some((damage, range_tiles_x100 edge to edge,
// cooldown_ds, prefer: Units | Buildings, Units when absent)), None when
// absent; requires_tech: Some("<techs.ron id>") on top of the age that
// unlocks the kind (ages.ron), None when absent. The sim reads them from
// the M4a tech and combat slices. The counter table at the end scales hits
// by attacker and defender in permille; a pair not listed is 1000.
(
  units: [
    (
      id: "yeoman",
      name: "Yeoman",
      speed_tiles_per_s_x100: 180,
      radius_tiles_x100: 35,
      arrive_radius_tiles_x100: 25,
      arrive_slowdown_radius_tiles_x100: 50,
      waypoint_radius_tiles_x100: 50,
      separation_tiles_x100: 10,
      return_to_post_radius_tiles_x100: 100,
      class: Civilian,
      hp: 40,
      cost: {"grain": 20},
      ramp: PerUnit({"grain": 1}),
      pop: 1,
      train_time_ds: 120,
      trainer: "town",
      builder: true,
      vision_tiles: 8,
    ),
    (
      id: "scribe",
      name: "Scribe",
      speed_tiles_per_s_x100: 180,
      radius_tiles_x100: 35,
      arrive_radius_tiles_x100: 25,
      arrive_slowdown_radius_tiles_x100: 50,
      waypoint_radius_tiles_x100: 50,
      separation_tiles_x100: 10,
      return_to_post_radius_tiles_x100: 100,
      class: Civilian,
      hp: 30,
      cost: {"grain": 30},
      pop: 1,
      train_time_ds: 150,
      trainer: "scriptorium",
      vision_tiles: 8,
    ),
    (
      id: "skirmisher",
      name: "Skirmisher",
      speed_tiles_per_s_x100: 220,
      radius_tiles_x100: 35,
      arrive_radius_tiles_x100: 25,
      arrive_slowdown_radius_tiles_x100: 50,
      waypoint_radius_tiles_x100: 50,
      separation_tiles_x100: 10,
      return_to_post_radius_tiles_x100: 100,
      class: Infantry,
      hp: 80,
      attack: Some((damage: 10, range_tiles_x100: 25, cooldown_ds: 10)),
      cost: {"grain": 40},
      ramp: Military,
      pop: 1,
      train_time_ds: 150,
      trainer: "muster_hall",
      vision_tiles: 8,
    ),
    (
      id: "shieldbearer",
      name: "Shieldbearer",
      speed_tiles_per_s_x100: 140,
      radius_tiles_x100: 40,
      arrive_radius_tiles_x100: 25,
      arrive_slowdown_radius_tiles_x100: 50,
      waypoint_radius_tiles_x100: 50,
      separation_tiles_x100: 10,
      return_to_post_radius_tiles_x100: 100,
      class: Infantry,
      hp: 130,
      attack: Some((damage: 12, range_tiles_x100: 25, cooldown_ds: 12)),
      cost: {"grain": 20, "ore": 40},
      ramp: Military,
      pop: 1,
      train_time_ds: 200,
      trainer: "muster_hall",
      vision_tiles: 8,
    ),
    (
      id: "bowman",
      name: "Bowman",
      speed_tiles_per_s_x100: 180,
      radius_tiles_x100: 35,
      arrive_radius_tiles_x100: 25,
      arrive_slowdown_radius_tiles_x100: 50,
      waypoint_radius_tiles_x100: 50,
      separation_tiles_x100: 10,
      return_to_post_radius_tiles_x100: 100,
      class: Infantry,
      hp: 46,
      attack: Some((damage: 10, range_tiles_x100: 500, cooldown_ds: 15)),
