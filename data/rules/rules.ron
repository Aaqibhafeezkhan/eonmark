// Eonmark match rules. Integers only: time in deciseconds (fields ending in
// _ds), distance in tiles (fields ending in _tiles). Converted to ticks once
// at load by rules::Rules::ticks_from_ds. Schema: crates/rules/src/lib.rs
// (deny_unknown_fields). Authoring guide: data/rules/README.md
(
  // 25: data/visuals.ron leaves rules_hash (ADR 0003); no sim change, no
  // value changed: every fixture is re-recorded for the new rules_version
  // and rules_hash in its header and no .hash moves.
  rules_version: 25,
  tick_rate_hz: 20,
  cmd_delay_ticks: 2,
  default_map: "plains_1v1",

  // Economy (M3a). The Yield Cap per resource per 30 s and the pop cap
  // before any Modifier row: from M4a the Trade techs Set the cap to 100,
  // 150 and 200 and each Arms level adds 25 pop (techs.ron).
  yield_cap_base: 70,
  pop_cap_base: 25,
  // Building cost = floor(base * (1000 + step * n) / 1000), n = copies of
  // the kind already owned, sites and the Seat included.
  building_ramp_step_permille: 200,
  // Military cost = floor(base * min(cap, 1000 + step * T(k - 1)) / 1000),
  // k = 1 + entries queued at the player's buildings of the trainer kind,
  // T(m) = m * (m + 1) / 2. The 6th queued unit reaches the cap.
  military_ramp_step_permille: 100,
  military_ramp_cap_permille: 2250,
  train_queue_max: 5,
  // An idle worker seeks a free slot after 50 ds (5 s = 100 ticks) and
  // retries every 50 ds while none is free.
  idle_seek_delay_ds: 50,
  idle_seek_retry_ds: 50,
  // Standard start, besides the Seat (one Town centred on the map start).
  standard_start: (
    units: {"yeoman": 5},
    stockpile: {"grain": 150, "lumber": 150, "ore": 0, "lore": 0},
  ),

  // Towns and borders (M3a). The town limit counts the Seat and Town
  // sites: 2 lets a player found a second Town before Statecraft (each
  // Statecraft level adds 1 to the limit and 1 tile to every own Town
  // radius, techs.ron). From M4a a Town grows to tier 2 only once its owner
  // has reached town_growth_age (an ages.ron id; None for no age gate).
  town_radius_tiles: 20,
  town_radius_grown_tiles: 24,
  town_growth_distinct_buildings: 5,
  town_growth_age: Some("masonry"),
  town_limit_base: 2,

  // Combat (M4a). damage_variance_permille (0..=500) spreads every hit by
  // a seeded draw in 1000 +/- v permille; 0 draws nothing. Units acquire
  // enemies within acquire_range_tiles, or within their weapon range when
  // that is longer. An explicit chase re-goals its path once the target's
  // tile is more than chase_regoal_tiles from the goal.
  damage_variance_permille: 0,
  acquire_range_tiles: 6,
  chase_regoal_tiles: 2,

  // Attrition, supply and annexation (M5a). 32 ds = 3.2 s; 600 ds = 60 s.
  // An enemy unit on a player's land loses HP every attrition interval once
  // that player has Harrying I (techs.ron); each Harrying level halves the
  // interval. A Supply Wain (units.ron `supplies`) covers its owner's units
  // within supply_radius_tiles (1..=64).
  supply_radius_tiles: 14,
  attrition_interval_ds: 32,
  annexation_ds: 600,
  // HP per pulse by max(0, owner age - intruder age); the last entry covers
  // larger gaps. Non-empty, from 1, never decreasing, each at most 1000.
  attrition_age_gap_hp: [1, 2],
  // Late-game pressure knob: harrying_bonus_hp extra HP per pulse once the
  // territory owner reaches harrying_bonus_age (an ages.ron id, or None).
  harrying_bonus_age: Some("charter"),
  harrying_bonus_hp: 0, // set at M6
  // A Town at 0 HP flips to the one enemy owner of attackers within
  // annexation_adjacent_tiles (1..=4) of its footprint once no defender has
  // been within annexation_defender_radius_tiles (1..=16, centre to centre)
  // for annexation_ds. Selectors as in techs.ron: Military, Class(..) or
  // Kind("<unit id>"); no Civilian kind may annex.
  annexation_adjacent_tiles: 1,
  annexation_defender_radius_tiles: 6,
  annexation_attackers: [Class(Infantry), Class(Cavalry)],
  annexation_defenders: [Military],
  annexation_town_hp_permille: 250, // a flipped Town keeps 500 of 2000 HP
  // The territory tiebreak ends the match: 27000 ds = 45 min = 54000 ticks.
  match_cap_ds: 27000,
  // Late-game Yield Cap decay: from minute 30 the cap falls by step every
  // 5 min. Off (step 0) until an M6 fun-gate iteration turns it on.
  yield_cap_decay_after_ds: 18000,
  yield_cap_decay_every_ds: 3000,
  yield_cap_decay_step: 0,

  // Pathfinding (M1). Expansions shared by all requests per tick; cache entries.
  path_budget_expansions: 4000,
  path_cache_entries: 1024,

  // Movement (M1). A moving unit repaths every repath_interval_ds (30 ds =
  // 60 ticks); the separation push is capped at speed / div so steering keeps
  // the upper hand (moving) and parked units yield slowly to a crowd (idle).
  repath_interval_ds: 30,
  separation_push_moving_div: 2,
  separation_push_idle_div: 8,
)
