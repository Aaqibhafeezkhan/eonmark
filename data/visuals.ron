// Eonmark visuals: how each unit and building kind is drawn. Schema:
// crates/rules/src/visuals.rs (deny_unknown_fields). `units` keys are unit
// kind ids from rules/units.ron and `buildings` keys building kind ids from
// rules/buildings.ron; every kind listed there must appear here (the loader
// rejects a missing or unknown key and names it). Loaded and validated by
// rules::Rules::load, so `sim-cli data-check` fails on a bad entry (and, with
// its assets check, on a Scene whose file is missing), but not part of
// rules_hash (ADR 0003, docs/adr/0003-visuals-outside-rules-hash.md): the sim
// never reads it, so a look edit needs no rules_version bump and no
// re-record. Nothing the sim reads may go in here. `cargo run -p
// inspect_gltf --release -- check data assets` measures every Scene below
// (triangles, ground contact, centre, team share, facing, suggested scale).
//
// Primitive(Capsule | Cuboid | Cylinder | Sphere | Cone): one shared mesh
//     sized from the kind's radius_tiles_x100 (a Capsule 3.4 radii tall,
//     the others 2 radii) and tinted with the owner's team colour (M2).
// Body(shape: Cone, height_tiles_x100: 150[, lying: true]): the same, two
//     radii wide but height_tiles_x100 tall (20..=400; a Capsule at least
//     two radii). lying (Capsule or Cylinder only) lays the shape along the
//     unit's facing, height_tiles_x100 long and two radii tall. Not Sphere
//     (M4b: one silhouette per kind, docs/ART_STYLE.md).
// The game draws every unit look low-poly and flat-shaded (crates/game/src/present.rs).
// Scene(path: "models/x.gltf", scale_x100: 100, y_offset_tiles_x100: 0, yaw_deg: 0
//     [, x_offset_tiles_x100: 0, z_offset_tiles_x100: 0, nodes: ["glob*"],
//     parts: [(path: ..., offset_x100: (x, y, z))], team: Some("swatch key"),
//     fallback: Some(...), banner_at: Some(mount), seat_flag_at: Some(mount)]):
//     a glTF model under assets/, merged into one mesh (crates/game/src/models.rs),
//     turned by yaw_deg, scaled, then moved by the three offsets, which
//     centre an off-centre file and lift a sunk one (the check prints both).
//     KayKit buildings face +Z (toward the camera) at yaw 0; a unit faces
//     +X at rest. A unit's fallback (a Primitive or a Body) is its look in
//     headless runs and if its model fails to load (art slice 4).
// mount = (offset_x100: (x, y, z)[, scale_x100: 100, yaw_deg: 0]): where a
//     banner or the Seat flag stands, from the footprint centre on the
//     ground (on a unit: from its position, in its own axes, +X ahead);
//     the offset places the flag's centre, its pole stands 0.11 m x scale
//     to its left, and yaw turns it (at 0 its cloth flies east, facing the
//     camera; the cloth is two-sided).
//
// buildings: a Scene with the owner's team swatch, or Primitive(Cuboid), the
//     M3b team-coloured box over the footprint (also every Scene's fallback).
//     A one-line swap: `"croft": Primitive(Cuboid),` (docs/ART_STYLE.md).
//     banner_at (owner decision 12 of the art pass) plants `banner`, the
//     KayKit flag repainted in team colour, on the building, sized so the
//     team share of model plus banner reaches the 100‰ floor of every kind
//     and placed inside the footprint (`inspect_gltf check` holds both): a
//     roof mount sinks the pole into the building so the cloth clears it,
//     and a free front corner of the footprint takes it on the ground.
//     Every banner is one shared mesh with one material per team. The
//     Mangonel carries the same banner (art slice 4), which follows it,
//     smaller, against its own 120‰ floor (owner decision 15).
//     seat_flag_at (Town kinds) puts `seat_flag` on a Seat: on the castle's
//     keep, inside the footprint and wholly above the Town's own banner, so
//     a Seat reads apart from any other Town by its place (owner decision
//     16 of 2026-10-28 accepted this rule; no height ratio applies).
// sites: one look per equal share of the build progress, neutral, scaled by
//     the footprint side; rubble: the wreck of a destroyed building for
//     ds deciseconds; terrain: props on forest, mountain and water (never
//     grass), placed by a tile hash (crates/game/src/terrain_props.rs): a
//     look only where its footprint stays on its own terrain, and nothing
//     over 1.6 m south of passable land.
(
  // Art slice 4: six KayKit Adventurers characters, posed and baked to
  // static models by `just art-bake` (tools/assets/bake.ron), scaled to the
  // art-pass heights (Yeoman 1.30 m, Scribe, Skirmisher and Bowman 1.40 m,
  // Shieldbearer 1.45 m, Outrider 2.05 m, 1.41x the Shieldbearer), lifted
  // 1 cm, each in its character's team swatch; the Mangonel is the catapult
  // of the KayKit catapult tower (its `catapult_*` nodes, turned to face +X,
  // lowered from the tower top) with the team banner centred on it (scale
  // 450, a 1.25 m banner, 123‰ against the Mangonel's own 120‰ floor, owner
  // decision 15 of 2026-10-28; it reaches 0.60 m from the centre, 0.10 m
  // past the engine's 0.5 m radius, docs/ART_STYLE.md); the Wain a
  // KayKit wheelbarrow loaded with a sack and a crate, flying the flag 1.4x
  // as a pennant. Each fallback is the kind's M4b look. A one-line swap
  // back: `"yeoman": Primitive(Capsule),` (docs/ART_STYLE.md).
  units: {
    "yeoman": Scene(path: "models/kaykit_adventurers/yeoman.glb", scale_x100: 58, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("adv_rogue"), fallback: Some(Primitive(Capsule))),
    "scribe": Scene(path: "models/kaykit_adventurers/scribe.glb", scale_x100: 53, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("adv_mage"), fallback: Some(Primitive(Cylinder))),
    "skirmisher": Scene(path: "models/kaykit_adventurers/skirmisher.glb", scale_x100: 59, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("adv_barbarian"), fallback: Some(Body(shape: Cone, height_tiles_x100: 150))),
    "shieldbearer": Scene(path: "models/kaykit_adventurers/shieldbearer.glb", scale_x100: 60, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("adv_knight"), fallback: Some(Body(shape: Cuboid, height_tiles_x100: 130))),
    "bowman": Scene(path: "models/kaykit_adventurers/bowman.glb", scale_x100: 63, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("adv_rogue"), fallback: Some(Body(shape: Cylinder, height_tiles_x100: 190))),
    "outrider": Scene(path: "models/kaykit_adventurers/outrider.glb", scale_x100: 84, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("adv_knight"), fallback: Some(Body(shape: Capsule, height_tiles_x100: 180, lying: true))),
    "mangonel": Scene(path: "models/kaykit_hexagon/buildings/blue/building_tower_catapult_blue.gltf", nodes: ["catapult_*"], scale_x100: 140, y_offset_tiles_x100: -195, yaw_deg: 90, x_offset_tiles_x100: 29, z_offset_tiles_x100: 6, team: Some("kaykit_hexagon"), fallback: Some(Primitive(Sphere)), banner_at: Some((offset_x100: (0, 0, 0), scale_x100: 450))),
    "supply_wain": Scene(path: "models/kaykit_hexagon/decoration/props/wheelbarrow.gltf", parts: [(path: "models/kaykit_hexagon/decoration/props/sack.gltf", offset_x100: (0, 11, 8), scale_x100: 130), (path: "models/kaykit_hexagon/decoration/props/crate_A_big.gltf", offset_x100: (0, 8, -6), scale_x100: 75), (path: "models/kaykit_hexagon/decoration/props/flag_blue.gltf", offset_x100: (0, 22, -8), scale_x100: 140)], scale_x100: 220, y_offset_tiles_x100: 1, yaw_deg: 90, x_offset_tiles_x100: 14, team: Some("kaykit_hexagon"), fallback: Some(Body(shape: Cuboid, height_tiles_x100: 60))),
  },
  // Scales fill 0.95 of the footprint side (the check's suggestion);
  // y_offset 1 lifts each base 1 cm off the ground; the x/z offsets centre
  // the lumbermill, barracks and blacksmith files. Banners (2026-10-28
  // review): on the castle's front-left tower over the gate (2.83 m, 102‰),
  // the cottage's front ridge, the lumbermill's front over its log yard,
  // the mine's front-left foot flying over the mine at 45° (2.33 m, the
  // only size that reaches 100‰ on 5‰ of rock), the barracks' west wing
  // over its roof, the tower's front edge, and the free front-left corner
  // of the church and the blacksmith on the ground.
  buildings: {
    "town": Scene(path: "models/kaykit_hexagon/buildings/blue/building_castle_blue.gltf", scale_x100: 126, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("kaykit_hexagon"), fallback: Some(Primitive(Cuboid)), banner_at: Some((offset_x100: (-9, 91, 110), scale_x100: 1020, yaw_deg: -15)), seat_flag_at: Some((offset_x100: (60, 490, 0), scale_x100: 650))),
    "croft": Scene(path: "models/kaykit_hexagon/buildings/blue/building_home_A_blue.gltf", scale_x100: 223, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("kaykit_hexagon"), fallback: Some(Primitive(Cuboid)), banner_at: Some((offset_x100: (28, 168, 70), scale_x100: 250))),
    "lumber_yard": Scene(path: "models/kaykit_hexagon/buildings/blue/building_lumbermill_blue.gltf", scale_x100: 139, y_offset_tiles_x100: 1, yaw_deg: 0, z_offset_tiles_x100: -19, team: Some("kaykit_hexagon"), fallback: Some(Primitive(Cuboid)), banner_at: Some((offset_x100: (5, 124, 84), scale_x100: 550))),
    "ore_pit": Scene(path: "models/kaykit_hexagon/buildings/blue/building_mine_blue.gltf", scale_x100: 99, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("kaykit_hexagon"), fallback: Some(Primitive(Cuboid)), banner_at: Some((offset_x100: (0, 0, 0), scale_x100: 840, yaw_deg: 45))),
    "scriptorium": Scene(path: "models/kaykit_hexagon/buildings/blue/building_church_blue.gltf", scale_x100: 247, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("kaykit_hexagon"), fallback: Some(Primitive(Cuboid)), banner_at: Some((offset_x100: (-110, 0, 130), scale_x100: 300, yaw_deg: -15))),
    "muster_hall": Scene(path: "models/kaykit_hexagon/buildings/blue/building_barracks_blue.gltf", scale_x100: 182, y_offset_tiles_x100: 1, yaw_deg: 0, z_offset_tiles_x100: -12, team: Some("kaykit_hexagon"), fallback: Some(Primitive(Cuboid)), banner_at: Some((offset_x100: (-37, 124, -18), scale_x100: 780))),
    "watchtower": Scene(path: "models/kaykit_hexagon/buildings/blue/building_tower_A_blue.gltf", scale_x100: 82, y_offset_tiles_x100: 1, yaw_deg: 0, team: Some("kaykit_hexagon"), fallback: Some(Primitive(Cuboid)), banner_at: Some((offset_x100: (0, 111, 41), scale_x100: 300))),
    "engine_yard": Scene(path: "models/kaykit_hexagon/buildings/blue/building_blacksmith_blue.gltf", scale_x100: 221, y_offset_tiles_x100: 1, yaw_deg: 0, x_offset_tiles_x100: -3, z_offset_tiles_x100: -14, team: Some("kaykit_hexagon"), fallback: Some(Primitive(Cuboid)), banner_at: Some((offset_x100: (-103, 0, 80), scale_x100: 350, yaw_deg: -15))),
  },
  // Construction stages A, B, C: a third of the build each.
  sites: [
    Scene(path: "models/kaykit_hexagon/buildings/neutral/building_stage_A.gltf", scale_x100: 91, y_offset_tiles_x100: 1, yaw_deg: 0),
    Scene(path: "models/kaykit_hexagon/buildings/neutral/building_stage_B.gltf", scale_x100: 84, y_offset_tiles_x100: 1, yaw_deg: 0),
    Scene(path: "models/kaykit_hexagon/buildings/neutral/building_stage_C.gltf", scale_x100: 82, y_offset_tiles_x100: 1, yaw_deg: 0),
  ],
  rubble: Some((visual: Scene(path: "models/kaykit_hexagon/buildings/neutral/building_destroyed.gltf", scale_x100: 62, y_offset_tiles_x100: 1, yaw_deg: 0), ds: 300)),
  // The KayKit flag, centred (its cloth faces +Z after the -90 yaw); one
  // model for the Seat flag and the banners, so they share one mesh.
  seat_flag: Some(Scene(path: "models/kaykit_hexagon/decoration/props/flag_blue.gltf", scale_x100: 100, y_offset_tiles_x100: 0, yaw_deg: -90, x_offset_tiles_x100: -11, team: Some("kaykit_hexagon"))),
  banner: Some(Scene(path: "models/kaykit_hexagon/decoration/props/flag_blue.gltf", scale_x100: 100, y_offset_tiles_x100: 0, yaw_deg: -90, x_offset_tiles_x100: -11, team: Some("kaykit_hexagon"))),
  // Texel rects of a model's base texture that the game repaints in the
  // owner's team colour (art pass). "kaykit_hexagon" is the union of the
  // rects `inspect_gltf swatches` found by diffing KayKit's blue and red
  // variants of every vendored building, the catapult tower and the flag
  // over the shared 1024x1024 hexagons_medieval.png (art slice 2): no
  // non-team face of any of them samples it. Every team building, the
  // banner, the Seat flag, the Mangonel and the Wain name it; the rest of
  // the atlas is desaturated 20% in their team textures. The "adv_*" rects
  // (art slice 4, picked with `inspect_gltf palette`) are cells of each
  // character's baked 256x256 atlas (one per character; the hooded Rogue
  // shares the Rogue's): the Rogues' green cloak, hood and sleeves, the
  // Mage's purple robe and hat, magenta cape and book cover, the Knight's
  // red tabard and cape, steel plate and two-handed grip, the Barbarian's
  // blue cloth, fur hat and cape and axe hafts; the rest is desaturated
  // 25%, so team colour stays the strongest hue.
  team_swatches: {
    "kaykit_hexagon": (rects: [(17, 787, 91, 207)], desaturate_permille: 200),
    "adv_rogue": (rects: [(0, 64, 64, 64)], desaturate_permille: 250),
    "adv_mage": (rects: [(0, 64, 96, 64), (32, 128, 32, 64)], desaturate_permille: 250),
    "adv_knight": (rects: [(0, 64, 32, 64), (96, 0, 32, 64), (64, 128, 32, 64)], desaturate_permille: 250),
    "adv_barbarian": (rects: [(0, 64, 64, 64), (64, 128, 32, 64), (224, 0, 32, 64)], desaturate_permille: 250),
  },
  // Every neutral model (terrain props, construction stages, rubble) is
  // desaturated this far toward grey, like the texels outside a team
  // swatch: KayKit's emerald trees (HSV saturation about 0.77 as shipped)
  // otherwise outshout both team colours (0.36-0.48 on screen).
  neutral_desaturate_permille: 500,
  // Interior looks are KayKit hex patches scaled to overlap their
  // neighbours; edge looks fit inside one tile. The 190% mountains need
  // two rings of mountain around them, so they rise in a range's middle.
  terrain: {
    "forest": (interior_permille: 1000, edge_permille: 600, jitter_x100: 30, scale_jitter_pct: 10, looks: [
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/trees_A_large.gltf", scale_x100: 130, y_offset_tiles_x100: 2, yaw_deg: 0), at: Interior, weight: 2),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/trees_B_large.gltf", scale_x100: 130, y_offset_tiles_x100: 3, yaw_deg: 0), at: Interior, weight: 2),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/trees_A_medium.gltf", scale_x100: 130, y_offset_tiles_x100: 3, yaw_deg: 0), at: Interior, weight: 1),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/trees_B_medium.gltf", scale_x100: 130, y_offset_tiles_x100: 3, yaw_deg: 0), at: Interior, weight: 1),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/tree_single_A.gltf", scale_x100: 110, y_offset_tiles_x100: 11, yaw_deg: 0), at: Edge, weight: 1),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/tree_single_B.gltf", scale_x100: 100, y_offset_tiles_x100: 10, yaw_deg: 0), at: Edge, weight: 1),
    ]),
    "mountain": (interior_permille: 1000, edge_permille: 700, jitter_x100: 30, scale_jitter_pct: 10, looks: [
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/mountain_A.gltf", scale_x100: 110, y_offset_tiles_x100: 0, yaw_deg: 0), at: Interior, weight: 1),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/mountain_B.gltf", scale_x100: 110, y_offset_tiles_x100: 0, yaw_deg: 0), at: Interior, weight: 1),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/mountain_C.gltf", scale_x100: 110, y_offset_tiles_x100: 0, yaw_deg: 0), at: Interior, weight: 1),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/mountain_B.gltf", scale_x100: 190, y_offset_tiles_x100: 0, yaw_deg: 0), at: Interior, weight: 6),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/mountain_C.gltf", scale_x100: 190, y_offset_tiles_x100: 0, yaw_deg: 0), at: Interior, weight: 6),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/rock_single_A.gltf", scale_x100: 200, y_offset_tiles_x100: 0, yaw_deg: 0), at: Edge, weight: 1),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/rock_single_B.gltf", scale_x100: 200, y_offset_tiles_x100: 0, yaw_deg: 0), at: Edge, weight: 1),
    ]),
    "water": (interior_permille: 60, edge_permille: 60, jitter_x100: 30, scale_jitter_pct: 10, looks: [
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/waterlily_A.gltf", scale_x100: 300, y_offset_tiles_x100: 0, yaw_deg: 0), at: Any, weight: 1, shadow: false),
      (visual: Scene(path: "models/kaykit_hexagon/decoration/nature/waterplant_A.gltf", scale_x100: 300, y_offset_tiles_x100: 6, yaw_deg: 0, x_offset_tiles_x100: 7, z_offset_tiles_x100: 4), at: Any, weight: 1, shadow: false),
    ]),
  },
)
