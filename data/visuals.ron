// Eonmark visuals: how each unit and building kind is drawn. Schema:
// crates/rules/src/visuals.rs (deny_unknown_fields). `units` keys are unit
// kind ids from rules/units.ron and `buildings` keys building kind ids from
// rules/buildings.ron; every kind listed there must appear here (the loader
// rejects a missing or unknown key and names it). Loaded and validated by
// rules::Rules::load, so `sim-cli data-check` fails on a bad entry (and, with
// its assets check, on a Scene whose file is missing), but not part of
// rules_hash (ADR 0003, docs/adr/0003-visuals-outside-rules-hash.md): the sim
// never reads it, so a look edit needs no rules_version bump and no
// re-record. Nothing the sim reads may go in here.
//
// Primitive(Capsule | Cuboid | Cylinder | Sphere | Cone): one shared mesh
//     sized from the kind's radius_tiles_x100 (a Capsule 3.4 radii tall,
//     the others 2 radii) and tinted with the owner's team colour (M2).
// Body(shape: Cone, height_tiles_x100: 150[, lying: true]): the same, two
//     radii wide but height_tiles_x100 tall (20..=400; a Capsule at least
//     two radii). lying (Capsule or Cylinder only) lays the shape along the
//     unit's facing, height_tiles_x100 long and two radii tall. Not Sphere
//     (M4b: one silhouette per kind, docs/ART_STYLE.md).
// The game draws every look low-poly and flat-shaded (crates/game/src/present.rs).
// Scene(path: "models/x.glb", scale_x100: 100, y_offset_tiles_x100: 0, yaw_deg: 0
//     [, nodes: ["glob*"], parts: [(path: ..., offset_x100: (x, y, z))],
//     team: Some("swatch key"), fallback: Some(Body(...))]): a glTF model under
//     assets/ (art pass); the game draws its fallback until models load.
//
// buildings: Primitive(Cuboid) is the M3b team-coloured box over the
//     footprint (crates/game/src/buildings.rs), or a Scene whose fallback is
//     that box. The art pass (docs/ROADMAP.md, "Art pass (pre-stream)") swaps
//     them for KayKit models one line at a time. Optional tables, empty or
//     default here: sites (default [Primitive(Cuboid)], the rising box),
//     rubble, seat_flag and terrain (props on forest, mountain and water);
//     team_swatches holds the KayKit Hexagon rects measured in art slice 2.
(
  units: {
    // Upright pill, 1.19 m (radius 0.35 m).
    "yeoman": Primitive(Capsule),
    // Drum, 0.7 x 0.7 m.
    "scribe": Primitive(Cylinder),
    // Spike: a 1.5 m cone.
    "skirmisher": Body(shape: Cone, height_tiles_x100: 150),
    // Block, 0.8 x 1.3 x 0.8 m.
    "shieldbearer": Body(shape: Cuboid, height_tiles_x100: 130),
    // Tall post, 1.9 m.
    "bowman": Body(shape: Cylinder, height_tiles_x100: 190),
    // Lying pill along the facing, 1.8 m long and 0.9 m tall.
    "outrider": Body(shape: Capsule, height_tiles_x100: 180, lying: true),
    // Ball, 1.0 m.
    "mangonel": Primitive(Sphere),
    // Low box, 1.0 x 0.6 x 1.0 m.
    "supply_wain": Body(shape: Cuboid, height_tiles_x100: 60),
  },
  // The M3b box for every kind until the art pass's models (slice 3).
  buildings: {
    "town": Primitive(Cuboid),
    "croft": Primitive(Cuboid),
    "lumber_yard": Primitive(Cuboid),
    "ore_pit": Primitive(Cuboid),
    "scriptorium": Primitive(Cuboid),
    "muster_hall": Primitive(Cuboid),
    "watchtower": Primitive(Cuboid),
    "engine_yard": Primitive(Cuboid),
  },
  // Texel rects of a model's base texture that the game repaints in the
  // owner's team colour (art pass). "kaykit_hexagon" is the union of the
  // rects `inspect_gltf swatches` found by diffing KayKit's blue and red
  // variants of every vendored building, the catapult tower and the flag
  // over the shared 1024x1024 hexagons_medieval.png (art slice 2): no
  // non-team face of any of them samples it. No Scene names it until slice 3.
  team_swatches: {
    "kaykit_hexagon": (rects: [(17, 787, 91, 207)], desaturate_permille: 200),
  },
  terrain: {},
)
